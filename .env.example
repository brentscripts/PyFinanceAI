# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Any random string; used by Flask to sign session cookies and CSRF tokens.
SECRET_KEY=change-me-to-a-random-string

# Path to the SQLite database file.
# Local dev: finance.db
# Docker:    /app/data/finance.db  (lives in the finance_data named volume)
DATABASE=finance.db

# Only used by docker-compose.yml, to map the container's port 5000
# to a port on your host machine.
HOST_PORT=5000
